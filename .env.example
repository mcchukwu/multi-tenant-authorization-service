# Application
APP_NAME=mtas
APP_PORT=6070
APP_ENV=development

# Database used by the app
DATABASE_URL=postgres://mtas:mtas@localhost:6071/mtas?sslmode=disable

# Database used by compose.yaml to start the container
DB_NAME=mtas
DB_USER=mtas
DB_PASSWORD=mtas
DB_PORT=6071

# Token lifetimes (Go durations)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Comma-separated browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173
